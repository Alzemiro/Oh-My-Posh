{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} \u2014 {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "shell",
          "style": "diamond",
          "leading_diamond": "\u256d\u2500\ue0b6",
          "trailing_diamond": "\ue0b0",
          "background": "#6272a4",
          "foreground": "#f8f8f2",
          "template": " \uf489 {{ .Name }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#bd93f9",
          "foreground": "#282a36",
          "properties": {
            "style": "folder",
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "\ue617"
          },
          "template": " \uf07b {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#f1fa8c",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffb86c{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff5555{{ end }}",
            "{{ if gt .Ahead 0 }}#8be9fd{{ end }}",
            "{{ if gt .Behind 0 }}#ff79c6{{ end }}"
          ],
          "foreground": "#282a36",
          "properties": {
            "branch_icon": "\ue725 ",
            "branch_max_length": 30,
            "fetch_status": true,
            "fetch_stash_count": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "background": "#44475a",
          "foreground": "#f8f8f2",
          "properties": {
            "always_enabled": false,
            "threshold": 500,
            "style": "austin"
          },
          "template": "<transparent,#44475a>\ue0b0</> \ueaba {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "diamond",
          "background": "#50fa7b",
          "background_templates": [
            "{{ if gt .Code 0 }}#ff5555{{ end }}"
          ],
          "foreground": "#282a36",
          "properties": {
            "always_enabled": true
          },
          "template": "<parentBackground>\ue0b0</> {{ if gt .Code 0 }}\uf00d {{ .Code }}{{ else }}\uf00c{{ end }} ",
          "trailing_diamond": "\ue0b4"
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hide",
      "segments": [
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#303030",
          "foreground": "#3c873a",
          "properties": {
            "fetch_version": true,
            "display_mode": "files",
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a>\ue5fa</> ",
            "yarn_icon": " <#348cba>\ue6a7</>"
          },
          "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} "
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#306998",
          "foreground": "#ffe873",
          "properties": {
            "fetch_version": true,
            "display_mode": "files",
            "fetch_virtual_env": true
          },
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}\uf47f {{ .Venv }} {{ end }}{{ .Full }}{{ end }} "
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#0e8ac8",
          "foreground": "#ffffff",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          },
          "template": "\ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#44475a",
          "foreground": "#f8f8f2",
          "properties": {
            "time_format": "15:04"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6272a4",
          "template": "\u2570\u2500"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#50fa7b",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ff5555{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "\ue285 "
        }
      ]
    }
  ]
}
